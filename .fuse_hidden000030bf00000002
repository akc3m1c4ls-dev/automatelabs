<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta
    name="description"
    content="Useful digital products that make everyday work simpler."
  >

  <title>AutomateLabs — less routine, more time</title>

  <!-- Favicon -->
  <link rel="icon" href="icons/favicon.png">

  <!-- Styles -->
  <link rel="stylesheet" href="style/style.css">
  <link rel="stylesheet" href="style/chatbot.css">
</head>

<body>

  <!-- =========================================================
       NAVIGATION
  ========================================================== -->

 <header class="navbar">

  <a
    href="#home"
    class="logo"
    aria-label="AutomateLabs home"
  >
    <img
      class="logo-mark"
      src="icons/favicon.png"
      alt=""
    >
    <span>AutomateLabs</span>
  </a>

  <nav
    class="nav-links"
    aria-label="Main navigation"
  >
    <a
      href="#products"
      data-i18n="nav.products"
    >
      Products
    </a>

    <a
      href="#how"
      data-i18n="nav.how"
    >
      How it works
    </a>

    <a
      href="#custom"
      data-i18n="nav.custom"
    >
      Custom Solutions
    </a>

    <a
      href="#contact"
      data-i18n="nav.contact"
    >
      Contact
    </a>
  </nav>

  <div class="nav-actions">

    <!-- Language selector -->
    <div class="language-picker" aria-label="Language">
      <button type="button" class="active" onclick="location.href='/'">EN</button>
      <span>|</span>
      <button type="button" onclick="location.href='/RU/'">RUS</button>
      <span>|</span>
      <button type="button" onclick="location.href='/EE/'">EE</button>
    </div>

    <!-- Cart -->
    <button
      class="cart-button"
      aria-label="Open cart"
    >
      <span data-i18n="cart.label">
        Check-out
      </span>

      <b class="cart-count">
        0
      </b>
    </button>

  </div>

</header>



  <!-- =========================================================
       MAIN CONTENT
  ========================================================== -->

  <main>


    <!-- =======================================================
         HERO
    ======================================================== -->

    <section
      id="home"
      class="section-shell hero"
    >

      <!-- Hero copy -->
      <div>

        <p
          class="eyebrow"
          data-i18n="hero.eyebrow"
        >
          DIGITAL PRODUCTS THAT HELP
        </p>

        <h1 data-i18n-html="hero.title">
          Let your website do<br>
          <em>the busy work.</em>
        </h1>

        <p
          class="lead"
          data-i18n="hero.text"
        >
          Make booking, customer questions and everyday tasks
          simpler—so there’s more time for the work that matters.
        </p>

        <div class="button-row">

          <a
            class="button primary"
            href="#products"
            data-i18n="hero.cta"
          >
            Explore products
          </a>

          <a
            class="text-link"
            href="#how"
            data-i18n="hero.secondary"
          >
            See how it works →
          </a>

        </div>

        <p
          class="hero-note"
          data-i18n="hero.note"
        >
          You stay in control. We take care of the repeatable parts.
        </p>

      </div>


      <!-- Interactive booking system -->
      <div
        class="booking-preview interactive-booking"
        id="hero-booking"
        aria-label="Online booking system"
      >
        <div class="interactive-booking-root"></div>
      </div>

    </section>


    <!-- =======================================================
         PRODUCTS
    ======================================================== -->

    <section
      id="products"
      class="section-shell products"
    >

      <div class="section-intro">

        <p
          class="eyebrow"
          data-i18n="products.eyebrow"
        >
          READY-MADE PRODUCTS
        </p>

        <h2 data-i18n-html="products.title">
          Useful from day one.<br>
          <em>Made to fit you.</em>
        </h2>

        <p data-i18n="products.text">
          Start with a clear product, then make it your own.
        </p>

      </div>


      <!-- Product carousel -->
      <div class="carousel-wrap">

        <button
          class="carousel-arrow previous"
          aria-label="Previous product"
        >
          ←
        </button>

        <div class="product-stage"></div>

        <button
          class="carousel-arrow next"
          aria-label="Next product"
        >
          →
        </button>

      </div>


      <div
        class="carousel-dots"
        aria-label="Choose product"
      ></div>

      <div
        class="carousel-progress"
        aria-hidden="true"
      >
        <span></span>
      </div>

    </section>


    <!-- =======================================================
         CUSTOM
    ======================================================== -->
<section id="custom" class="section-shell custom-section">

  <div class="custom-copy">

    <p class="eyebrow" data-i18n="custom.eyebrow">
      NEED SOMETHING DIFFERENT?
    </p>

    <h2 data-i18n-html="custom.title">
      Your work has its own rhythm.<br>
      <em>We’ll build around it.</em>
    </h2>

    <p data-i18n="custom.text">
      We’ll create a practical digital solution around your
      people, process and customers.
    </p>

    <a
      href="products/custom.html"
      class="button primary custom-button"
      data-i18n="custom.cta"
    >
      Custom solution
      <span>→</span>
    </a>

  </div>


  <div class="custom-flow">

    <!-- 01 -->
    <a href="products/custom.html" class="custom-card">

      <div class="custom-icon">
        <img src="icons/01-work.svg" alt="">
      </div>

      <div class="custom-card-number">
        01
      </div>

      <div class="custom-card-content">
        <small>INPUT</small>

        <h3>Your day-to-day work</h3>

        <p>
          We start with the way your business
          actually works.
        </p>
      </div>

      <div class="custom-arrow">
        →
      </div>

    </a>


    <!-- 02 -->
    <a href="products/custom.html" class="custom-card">

      <div class="custom-icon">
        <img src="icons/02-process.svg" alt="">
      </div>

      <div class="custom-card-number">
        02
      </div>

      <div class="custom-card-content">
        <small>PROCESS</small>

        <h3>A clearer digital flow</h3>

        <p>
          We turn repetitive steps into a simple
          digital process.
        </p>
      </div>

      <div class="custom-arrow">
        →
      </div>

    </a>


    <!-- 03 -->
    <a href="products/custom.html" class="custom-card">

      <div class="custom-icon">
        <img src="icons/03-result.svg" alt="">
      </div>

      <div class="custom-card-number">
        03
      </div>

      <div class="custom-card-content">
        <small>RESULT</small>

        <h3>More time for people</h3>

        <p>
          Your team spends less time managing
          routine work.
        </p>
      </div>

      <div class="custom-arrow">
        →
      </div>

    </a>

    </div>

  </div>

</section>

<!-- =======================================================
     HOW IT WORKS?
======================================================== -->

    <section id="how" class="how">

      <div class="how-header">

        <p class="eyebrow">
          HOW IT WORKS
        </p>

        <h2>
          From purchase<br>
          <em>to ready to use.</em>
        </h2>

      </div>


      <div class="how-grid">

        <!-- 01 -->
        <article class="how-card">

          <div class="how-number">
            01
          </div>

          <div class="how-card-content">

            <h3>
              Choose &amp; buy
            </h3>

            <p>
              Choose the product that fits your needs
              and place your order.
            </p>

          </div>

          <div class="how-visual">
            <img
              src="icons/04-buy.png"
              alt=""
              class="how-card-image"
            >
          </div>

        </article>


        <!-- 02 -->
        <article class="how-card">

          <div class="how-number">
            02
          </div>

          <div class="how-card-content">

            <h3>
              We set it up
            </h3>

            <p>
              Our technician contacts you and handles
              the setup, configuration and connections.
            </p>

          </div>

          <div class="how-visual">
            <img
              src="icons/05-work.png"
              alt=""
              class="how-card-image"
            >
          </div>

        </article>


        <!-- 03 -->
        <article class="how-card">

          <div class="how-number">
            03
          </div>

          <div class="how-card-content">

            <h3>
              Happy usage
            </h3>

            <p>
              Everything is ready. Start using your
              new system without the technical hassle.
            </p>

          </div>

          <div class="how-visual">
            <img
              src="icons/06-success.png"
              alt=""
              class="how-card-image"
            >
          </div>

        </article>

      </div>

    </section>


    
<!-- =========================================================
     CONTACT / REQUEST
========================================================= -->

<section id="contact" class="contact-section">

  <!-- =======================================================
       LEFT 60% - REQUEST
  ======================================================== -->

  <div class="contact-request">

    <p class="eyebrow">
      REQUEST A SOLUTION
    </p>

    <h2>
      Tell us what you'd like<br>
      <em>to automate.</em>
    </h2>

    <p class="contact-intro">
      Tell us a little about the task you'd like to improve.
      We'll work out the practical solution with you.
    </p>


    <form class="contact-form">

      <div class="form-row">

        <div class="form-field">

          <label for="contact-name">
            Name
          </label>

          <input
            type="text"
            id="contact-name"
            name="name"
            placeholder="Your name"
            required
          >

        </div>


        <div class="form-field">

          <label for="contact-email">
            Email
          </label>

          <input
            type="email"
            id="contact-email"
            name="email"
            placeholder="you@company.com"
            required
          >

        </div>

      </div>


      <div class="form-field">

        <label for="contact-company">
          Company
        </label>

        <input
          type="text"
          id="contact-company"
          name="company"
          placeholder="Your company"
        >

      </div>


      <div class="form-field">

        <label for="contact-message">
          Tell us what you'd like to automate
        </label>

        <textarea
          id="contact-message"
          name="message"
          rows="4"
          placeholder="Tell us what you'd like to automate..."
          required
        ></textarea>

      </div>


      <button
        type="submit"
        class="button primary contact-submit"
      >
        Send request
        <span>→</span>
      </button>

    </form>

  </div>


  <!-- =======================================================
       RIGHT 40%
  ======================================================== -->

  <div class="contact-side">


    <!-- ABOUT -->

    <div class="contact-about">

      <p class="eyebrow">
        ABOUT AUTOMATELABS
      </p>

      <h3>
        Useful<br>
        technology.<br>
        <em>Made human.</em>
      </h3>

      <p>
        AutomateLabs creates calm, practical digital tools
        for the parts of work that take too much time.
        Every service starts with a real routine and ends
        with a clearer experience for the people using it.
      </p>

    </div>


    <!-- DIVIDER -->

    <div class="contact-side-line"></div>


    <!-- CONTACT -->

    <div class="contact-details">

      <h3>
        Contacts:
      </h3>


      <div class="contact-detail">

        <small>
          EMAIL
        </small>

        <a href="mailto:hello@automatelabs.me">
          hello@automatelabs.me
        </a>

      </div>

      <div class="contact-detail">

        <small>
          PHONE
        </small>

        <span>
          +372 5857 8858
        </span>

      </div>

      <div class="contact-detail">

        <small>
          LOCATION
        </small>

        <span>
          Estonia, Tallinn
        </span>

      </div>

    </div>


  </div>

</section>


  <!-- =========================================================
       FOOTER
  ========================================================== -->

  <footer>

    <div class="logo">

      <img
        class="logo-mark"
        src="icons/favicon.png"
        alt=""
      >

      <span>
        AutomateLabs
      </span>

    </div>

    <span data-i18n="footer">
      Useful digital products for everyday work.
    </span>

    <span class="copyright"></span>

  </footer>


  <!-- =========================================================
       CART DRAWER
  ========================================================== -->

  <div class="drawer-backdrop"></div>


  <aside
    class="cart-drawer"
    aria-label="Shopping cart"
  >

    <!-- Drawer header -->
    <div class="drawer-head">

      <div>

        <span data-i18n="cart.label">
          Check-out
        </span>

        <h2 data-i18n="cart.title">
          Your cart:
        </h2>

      </div>

      <button
        class="drawer-close"
        aria-label="Close cart"
      >
        ×
      </button>

    </div>


    <!-- Cart items -->
    <div class="cart-items"></div>


    <!-- Empty cart message -->
    <p
      class="cart-empty"
      data-i18n="cart.empty"
    >
      Your cart is ready when you are.
    </p>


    <!-- Cart footer -->
    <div class="cart-footer">

      <div>

        <span data-i18n="cart.total">
          Total
        </span>

        <b class="cart-total">
          €0
        </b>

      </div>

      <button
        class="button primary checkout"
        data-i18n="cart.checkout"
      >
        Checkout
      </button>

    </div>

  </aside>


  <!-- =========================================================
       JAVASCRIPT
  ========================================================== -->

  <script src="script/script.js"></script>
  <script src="script/chatbot.js"></script>

</body>

</html>

